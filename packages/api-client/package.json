{
  "name": "@org/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "nx": {
    "implicitDependencies": [
      "@org/spring-server"
    ],
    "targets": {
      "generate": {
        "command": "openapi-typescript ../../apps/spring-server/build/openapi/openapi.json -o src/generated/schema.ts && prettier --write src/generated",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          {
            "projects": [
              "@org/spring-server"
            ],
            "target": "generateOpenApi"
          }
        ],
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/openapi.json"
          },
          {
            "externalDependencies": [
              "openapi-typescript"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true
      },
      "build": {
        "executor": "nx:noop"
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "generate"
        ]
      }
    }
  }
}
